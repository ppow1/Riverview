# Riverview Comms5 external ingress.
# Add this route beside the unchanged Riverview Comms4 route on the approved
# Caddy host. Keep both bearer values in the Caddy service environment.

riverview-comms.ionoge.com {
    @comms5 {
        path /comms5/mcp
        method GET POST OPTIONS DELETE
    }

    handle @comms5 {
        @authorized header Authorization "Bearer {env.RIVERVIEW_COMMS5_CLIENT_SECRET}"
        handle @authorized {
            uri replace /comms5/mcp /mcp
            request_body {
                max_size 256KB
            }
            reverse_proxy 127.0.0.1:11826 {
                header_up Authorization "Bearer {env.RIVERVIEW_COMMS5_UPSTREAM_AUTH}"
                header_up X-Riverview-Comms5 1
                header_up Host 127.0.0.1:11826
                transport http {
                    read_timeout 20s
                    write_timeout 20s
                }
            }
        }
        respond "unauthorized" 401
    }
}
