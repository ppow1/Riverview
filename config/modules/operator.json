{
  "module_id": "riverview.operator",
  "display_name": "Riverview Operator surface",
  "module_version": "1.0.0",
  "required_core_contract": "riverview-core-contract-1.0",
  "module_type": "ui",
  "events_consumed": ["diagnostic.checkpoint", "resident.response.completed", "room.turn.completed"],
  "events_emitted": ["resident.message.submitted", "resident.response.completed", "operator.response.completed", "room.created", "room.turn.completed", "operator.snapshot.created", "microphone.transcript.completed", "grace.conversation.completed"],
  "actions_requested": ["resident.chat", "room.chat", "operator.snapshot"],
  "projections_read": ["resident.registry", "room.state", "operator.conversations", "diagnostics.recent"],
  "capabilities_registered": ["browser.operator", "resident.selection", "snapshot.export"],
  "routes": ["/", "/session", "/api/chat", "/api/conversations", "/api/rooms", "/api/architecture", "/snapshot"],
  "diagnostics": ["RIV-UI-0013", "RIV-UI-0014", "RIV-UI-0019", "RIV-UI-0020", "RIV-UI-0021", "RIV-RES-0002"],
  "storage_owner": "postgresql.operator_projection",
  "dependencies": ["river", "reasoning.contract", "resident.gateway"],
  "authority": ["read:bounded", "return:advisory"],
  "recovery": "bounded failure, diagnostic checkpoint, retry without authority expansion"
}
